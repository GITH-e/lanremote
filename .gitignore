
# ==========================================
# LanRemote - Git Ignore Rules
# Android + Windows Remote Desktop Project
# ==========================================


# 1. Git 本地目录
.git/


# 2. Python 缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/


# 3. Python 虚拟环境
.venv/
venv/
env/
ENV/


# 4. Python 第三方依赖
.deps/
.tox/
.nox/


# 5. 本地开发工具和下载工具
.tools/


# 6. 编译和打包输出
/build/
/dist/
*.egg-info/
.eggs/
wheels/


# 7. Android Gradle 缓存
.gradle/
**/.gradle/
**/build/


# 8. Android 本机配置
**/local.properties


# 9. Android 签名密钥及证书
*.jks
*.keystore
*.p12
*.pfx
*.mobileprovision


# 10. 私钥文件
*.pem
*.key


# 11. 环境变量和密钥配置
.env
.env.*
!.env.example
!.env.*.example


# 12. 常见密码和密钥文件
secrets.json
secret.json
credentials.json
credentials.json.*
secrets.yaml
secrets.yml
*.secret


# 13. 临时下载文件
*.partial
*.tmp
*.temp
*.download


# 14. 日志文件
*.log
logs/


# 15. 本机防火墙诊断记录
firewall-before.txt
firewall-repair-result.txt


# 16. Windows 系统垃圾文件
Thumbs.db
Desktop.ini
$RECYCLE.BIN/


# 17. macOS 系统垃圾文件
.DS_Store
.AppleDouble
.LSOverride


# 18. 编辑器和 IDE 本机配置
.idea/
*.iml
.vs/


# 19. 临时文件
*.bak
*.old
*.swp
*.swo
*~


# 20. 不忽略项目打包配置
# LanRemote-Windows.spec 必须保留并上传
